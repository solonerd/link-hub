# 复制本文件为 .env 并填入你自己的值（.env 已被 .gitignore 忽略，切勿提交）

# ---------- 邮件（QQ 邮箱需使用 SMTP 授权码，而非登录密码）----------
MAIL_USERNAME=your_mail@example.com
MAIL_PASSWORD=your_mail_smtp_auth_code

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=shortlink_db
MYSQL_PASSWORD=your_mysql_password
DB_PASSWORD=your_mysql_password

# ---------- Redis ----------
REDIS_PASSWORD=your_redis_password
# Redis 集群演示时宿主机 IP（可选）
# HOST_IP=192.168.x.x

# ---------- RabbitMQ ----------
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASS=your_rabbitmq_password

# ---------- JWT（至少 32 字节）----------
JWT_SECRET_KEY=your_jwt_secret_at_least_32_bytes_long

# ---------- AI ----------
AI_API_KEY=your_ai_api_key
EMBEDDING_API_KEY=your_embedding_api_key